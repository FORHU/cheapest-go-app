# ── Database ─────────────────────────────────────────────────────────────────
# Dev (Docker):  postgresql://cheapestgo:cheapestgo@localhost:5432/cheapestgo
# Prod (AWS RDS): postgresql://user:password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/cheapestgo?sslmode=require
DATABASE_URL=postgresql://cheapestgo:cheapestgo@localhost:5432/cheapestgo
DATABASE_URL_UNPOOLED=postgresql://cheapestgo:cheapestgo@localhost:5432/cheapestgo
DATABASE_SSL=false  # set to true for production RDS

# The database the `app` container in docker-compose.yml talks to (published on 3001),
# kept separate from DATABASE_URL above so `npm run dev` on 3000 stays on local postgres.
# Real values live in .env, which is gitignored — never commit a connection string.
# docker compose refuses to start the container if RDS_DATABASE_URL is unset, rather
# than quietly falling back to the local database.
RDS_DATABASE_URL=postgresql://user:password@your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/cheapestgo?sslmode=require
RDS_DATABASE_URL_UNPOOLED=  # optional; defaults to RDS_DATABASE_URL

# ── pgAdmin (docker-compose, published on 5051) ───────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=choose_your_own

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generated with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/auth/callback (dev)
#                          https://yourdomain.com/auth/callback (prod)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Internal function security ───────────────────────────────────────────────
FUNCTIONS_SECRET=your_internal_secret_here
CRON_SECRET=your_cron_secret_here

# ── Flight Providers ─────────────────────────────────────────────────────────
DUFFEL_ACCESS_TOKEN=your_duffel_access_token

# ── Hotel Providers ───────────────────────────────────────────────────────────
TRAVELGATEX_API_KEY=your_travelgatex_api_key
TRAVELGATEX_CODE=2
TRAVELGATEX_ENDPOINT_URL=https://api.travelgate.com

ONDA_API_KEY=your_onda_api_key
ONDA_BASE_URL=https://dapi.tport.dev

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key

# ── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# ── External APIs ────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key
ETG_KEY_ID=17012
ETG_API_KEY=your_etg_api_key

# ── Pricing (see src/lib/pricing.ts and docs/adr/0031-*.md) ──────────────────
# Recovers Platform Cost — Stripe plus the supplier platform's own fees — and
# nothing more. Flights carry the larger flat component because Duffel charges
# $3.00 per paid order on top of 1% of order value. Hotels carry a small one
# covering Stripe's $0.30 only: the OTV invoice is the room cost itself, and
# TravelgateX is not yet billing a connection fee. When it does, hotels go up.
FLIGHT_MARKUP_PERCENTAGE=0.072
FLIGHT_MARKUP_FLAT_USD=4.40
HOTEL_MARKUP_PERCENTAGE=0.059
HOTEL_MARKUP_FLAT_USD=0.40
# Ceiling on the whole fee as a share of the base price, so the flat component
# cannot dominate a cheap fare. Binds below roughly $90.
MARKUP_CAP=0.12
# Stripe's cut. NOT the headline 2.9% — every live charge settles at 2.9% + 1.5%
# (international card) + $0.30, measured 2026-09-08. A KRW charge is also
# converted and will be ~1 point higher again: re-check with
# `node scratch/stripe-fees.mjs` before AirangGo takes live bookings.
STRIPE_RATE=0.044
STRIPE_FLAT_FEE=0.30

# ── Mobile API ───────────────────────────────────────────────────────────────
MOBILE_API_KEY=your_mobile_api_key

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Monitoring ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=cheapestgo

# ── Support chat attachments (ADR-0040) ──────────────────────────────────────────────
# Private S3 bucket holding files customers and Agents send in Support Chat.
# Credentials are NOT set here: the app reads them from the EC2 instance role in
# production and from your local AWS profile in development. Never add an access key.
# Leave the bucket unset and the widget simply hides the paperclip.
AWS_REGION=ap-southeast-1
SUPPORT_ATTACHMENTS_BUCKET=

# Support message translation (ADR-0033, ADR-0034). Base URL of the Chatwonder service
# used to render support messages between the customer's language and English.
# Falls back to CHAT_WONDER_API_URL, which the deploy workflows already set; with neither,
# no translations are stored and messages are delivered as their author wrote them.
TRANSLATION_BASE_URL=
