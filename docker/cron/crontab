# cheapest-go cron schedule
# All jobs hit the app container directly over the Docker network (no external roundtrip).
# CRON_SECRET and APP_URL are injected from docker-compose environment.
#
# Every entry must name a route that exists under src/app/api/. `curl -sf` exits
# non-zero on a 404 but prints nothing and the output is discarded, so a schedule
# pointing at a route that was never built looks exactly like one that runs fine.
# Three did: warm-hotel-cache, sync-hotel-deals, and duffel-balance-check — the
# last of which was the only advance warning of the Duffel balance running dry,
# which fails every flight booking at order creation. It is not rescheduled here
# because Duffel exposes no balances endpoint to poll (see the note in
# src/app/api/flights/book/route.ts); add it back with the route when they do.

# ── High-frequency ────────────────────────────────────────────────────────────
# A customer's widget holds an Agent's reply until its translation settles, so a
# translation a deploy interrupted must be finished promptly — a customer is waiting.
# Does nothing (one indexed query) on almost every run.
*    * * * * curl -sf -X GET  $APP_URL/api/cron/resume-support-translations    -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
*/5  * * * * curl -sf -X GET  $APP_URL/api/cron/poll-pending-tickets           -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
*/10 * * * * curl -sf -X POST $APP_URL/api/internal/auto-recover               -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
*/10 * * * * curl -sf -X GET  $APP_URL/api/cron/cleanup-orphaned-duffel-orders -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
*/15 * * * * curl -sf -X POST $APP_URL/api/internal/retry-emails               -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
*/30 * * * * curl -sf -X GET  $APP_URL/api/cron/refresh-popular-flights        -H "Authorization: Bearer $CRON_SECRET" -o /dev/null

# ── Sub-daily ─────────────────────────────────────────────────────────────────
0 */6  * * * curl -sf -X GET $APP_URL/api/cron/sync-flight-deals    -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
0 */12 * * * curl -sf -X GET $APP_URL/api/cron/otv-credit-check     -H "Authorization: Bearer $CRON_SECRET" -o /dev/null

# ── Weekly (UTC) ─────────────────────────────────────────────────────────────
0 1 * * 0 curl -sf -X GET $APP_URL/api/cron/sync-dest-cache    -H "Authorization: Bearer $CRON_SECRET" -o /dev/null

# ── Daily (UTC) ───────────────────────────────────────────────────────────────
0 2 * * * curl -sf -X GET $APP_URL/api/cron/etg-reviews-sync   -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
0 3 * * * curl -sf -X GET $APP_URL/api/cron/cache-cleanup       -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
0 4 * * * curl -sf -X GET $APP_URL/api/cron/cleanup-sessions    -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
# Retention for support attachments (ADR-0040). Daily and off-peak: the working set is
# whatever crossed 90 days since its conversation was resolved, which is a trickle, and
# each row costs an S3 delete. Runs after cleanup-sessions so the two do not overlap.
0 4 * * * curl -sf -X GET $APP_URL/api/cron/purge-support-attachments -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
0 6 * * * curl -sf -X GET $APP_URL/api/cron/check-price-alerts  -H "Authorization: Bearer $CRON_SECRET" -o /dev/null

# ── Monthly (UTC) ─────────────────────────────────────────────────────────────
# On the 5th, after Duffel issues its invoice (by the 3rd), so the reported
# Platform Cost can be checked against the real bill rather than standing alone.
0 5 5 * * curl -sf -X GET $APP_URL/api/cron/platform-cost-reconciliation -H "Authorization: Bearer $CRON_SECRET" -o /dev/null
