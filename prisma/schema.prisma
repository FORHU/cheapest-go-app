  user_id                   String            @db.Uuid
  provider                  String
  flight                    Json              @default("{}")
  passengers                Json              @default("[]")
  contact                   Json              @default("{}")
  status                    String            @default("pending")
  expires_at                DateTime          @db.Timestamptz(6)
