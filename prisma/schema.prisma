datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_audit_log {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String
  admin_id    String?  @db.Uuid
  admin_email String?
  target_id   String?
  details     Json?    @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model admin_settings {
  key        String    @id
  value      Json      @default("\"\"")
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model api_keys {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  name         String
  key_hash     String    @unique
  key_prefix   String
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  is_active    Boolean   @default(true)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

model api_logs {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         String
  endpoint         String
  method           String?   @default("POST")
  request_params   Json?
  response_status  Int?
  response_summary Json?
  duration_ms      Int       @default(0)
  error_message    String?
  user_id          String?   @db.Uuid
  search_id        String?   @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_api_logs_created_at")
  @@index([provider], map: "idx_api_logs_provider")
}

model booking_emails {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String
  recipient_email String
  guest_name      String?
  hotel_name      String?
  room_name       String?
  check_in        String?
  check_out       String?
  total_price     Decimal?  @db.Decimal
  currency        String?   @default("PHP")
  email_html      String?
  sent_at         DateTime? @default(now()) @db.Timestamptz(6)
  status          String?   @default("queued")
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([booking_id], map: "idx_booking_emails_booking_id")
  @@index([status], map: "idx_booking_emails_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking_financial_events {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String          @db.Uuid
  event_type      String
  amount          Decimal         @db.Decimal(12, 2)
  currency        String
  provider        String
  transaction_id  String?
  metadata        Json?           @default("{}")
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  flight_bookings flight_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id], map: "idx_booking_financial_events_booking_id")
  @@index([transaction_id], map: "idx_booking_financial_events_transaction_id")
}

model booking_policy_snapshots {
  id                                                             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id                                                     String              @unique(map: "uq_policy_per_booking")
  policy_type                                                    booking_policy_type @default(non_refundable)
  summary                                                        String?
  refundable_tag                                                 String?
  hotel_remarks                                                  String[]            @default([])
  no_show_penalty                                                Decimal?            @default(0) @db.Decimal(10, 2)
  early_departure_fee                                            Decimal?            @default(0) @db.Decimal(10, 2)
  free_cancel_deadline                                           DateTime?           @db.Timestamptz(6)
  raw_provider_response                                          Json                @default("{}")
  captured_at                                                    DateTime            @default(now()) @db.Timestamptz(6)
  api_version                                                    String?
  raw_liteapi_response                                           Json                @default("{}")
  bookings_booking_policy_snapshots_booking_idTobookings         bookings            @relation("booking_policy_snapshots_booking_idTobookings", fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)
  bookings_bookings_policy_snapshot_idTobooking_policy_snapshots bookings[]          @relation("bookings_policy_snapshot_idTobooking_policy_snapshots")
  policy_tiers                                                   policy_tiers[]
  refund_logs                                                    refund_logs[]

  @@index([booking_id], map: "idx_policy_snapshot_booking")
}

